# Ambiente: development | testing | production
FLASK_ENV=development

# Chaves de assinatura.
# Deixar em branco e valido apenas em desenvolvimento: a aplicacao usa um
# valor local de fallback e registra um aviso no log. Em producao a aplicacao
# se recusa a subir sem valores reais.
# Gere cada uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Banco de dados. Em branco usa backend/instance/weather.db
DATABASE_URL=

# Origens permitidas pelo CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# Integracoes externas
OPENWEATHER_KEY=
# Sem esta chave, os Insights do Dia continuam funcionando (sao deterministicos),
# mas o assistente responde que nao esta configurado.
# Qualquer endpoint compativel com OpenAI serve. Exemplos:
#   OpenAI     AI_BASE_URL=https://api.openai.com/v1        OPENAI_MODEL=gpt-4o-mini
#   Groq       AI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter AI_BASE_URL=https://openrouter.ai/api/v1     OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama     AI_BASE_URL=http://localhost:11434/v1        OPENAI_MODEL=llama3.2
OPENAI_KEY=
AI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
NOMINATIM_USER_AGENT=Climora/1.0 (contato@exemplo.com)
EXTERNAL_API_TIMEOUT=10

# Observabilidade
LOG_LEVEL=INFO

# Servidor de desenvolvimento
HOST=127.0.0.1
PORT=5000
